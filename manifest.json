{
  "manifest_version": 3,
  "name": "Shelf",
  "version": "0.1.0",
  "description": "A calm new tab page built from your bookmarks, with spaces, a clock and weather",
  "author": "pallad42",
  "homepage_url": "https://github.com/pallad42/shelf-vivaldi",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "incognito": "split",
  "permissions": [
    "bookmarks",
    "favicon",
    "storage",
    "unlimitedStorage",
    "tabs"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
